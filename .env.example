NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-drive/callback

APP_ENCRYPTION_KEY=
APP_TOKEN_PEPPER=

# Bootstrap de administradores (ver docs/decisions/0002): emails separados
# por vírgula que são sempre tratados como admin, mesmo antes de existir
# alguém com profiles.role = 'admin' na base de dados.
ADMIN_EMAILS=

# 4 MB por omissão para caber no limite de 4,5 MB por pedido das
# Serverless Functions da Vercel (docs/decisions/0009-deploy-vercel.md).
# Em Cloud Run/Docker, sem esse limite, pode voltar a 26214400 (25 MB).
MAX_UPLOAD_BYTES=4000000
MAX_FILES_PER_UPLOAD=50
MAX_PHOTOS_PER_ALBUM=5000
PREVIEW_MAX_EDGE=1600
THUMBNAIL_MAX_EDGE=480

# Opcionais para desenvolvimento local; fortemente recomendados em
# produção (ver docs/operations/production-checklist.md) — sem
# UPSTASH_REDIS_REST_URL/TOKEN, o rate limiting fica desligado
# (lib/security/rate-limit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=

# Protege /api/cron/sync-drive-deletions (sincronização com eliminações
# feitas diretamente no Google Drive — ver
# server/use-cases/drive-sync.ts). Gerar um valor aleatório com pelo
# menos 32 caracteres (ex.: `openssl rand -hex 32`) e configurar em
# Vercel > Settings > Environment Variables com o nome exato
# CRON_SECRET — a Vercel injeta-o automaticamente como cabeçalho
# "Authorization: Bearer <valor>" nos Cron Jobs definidos em
# vercel.json. Sem esta variável, a rota fecha por omissão.
CRON_SECRET=
